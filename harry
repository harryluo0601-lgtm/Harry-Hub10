local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- === 1. 建立 GUI 介面 ===
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PlayerTrackerGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- 主視窗
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 300, 0, 180)
MainFrame.Position = UDim2.new(0.5, -150, 0.4, -90)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true -- 允許在畫面上拖動
MainFrame.Parent = ScreenGui

-- 圓角效果
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

-- 標題
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Text = "Roblox 玩家追蹤傳送器"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 16
Title.Font = Enum.Font.SourceSansBold
Title.BackgroundTransparency = 1
Title.Parent = MainFrame

-- 輸入框 (Input)
local TextBox = Instance.new("TextBox")
TextBox.Size = UDim2.new(0, 240, 0, 35)
TextBox.Position = UDim2.new(0.5, -120, 0, 55)
TextBox.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
TextBox.PlaceholderText = "請輸入目標玩家的 User ID"
TextBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
TextBox.Text = ""
TextBox.TextSize = 14
TextBox.Font = Enum.Font.SourceSans
TextBox.BorderSizePixel = 0
TextBox.Parent = MainFrame

local TextBoxCorner = Instance.new("UICorner")
TextBoxCorner.CornerRadius = UDim.new(0, 5)
TextBoxCorner.Parent = TextBox

-- 按鈕 (Button)
local TeleportButton = Instance.new("TextButton")
TeleportButton.Size = UDim2.new(0, 240, 0, 35)
TeleportButton.Position = UDim2.new(0.5, -120, 0, 105)
TeleportButton.BackgroundColor3 = Color3.fromRGB(0, 150, 136)
TeleportButton.TextColor3 = Color3.fromRGB(255, 255, 255)
TeleportButton.Text = "開始追蹤並傳送"
TeleportButton.TextSize = 14
TeleportButton.Font = Enum.Font.SourceSansBold
TeleportButton.BorderSizePixel = 0
TeleportButton.Parent = MainFrame

local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(0, 5)
ButtonCorner.Parent = TeleportButton

-- 狀態提示文字
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 20)
StatusLabel.Position = UDim2.new(0, 0, 0, 150)
StatusLabel.Text = "等待輸入..."
StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
StatusLabel.TextSize = 12
StatusLabel.Font = Enum.Font.SourceSansItalic
StatusLabel.BackgroundTransparency = 1
StatusLabel.Parent = MainFrame


-- === 2. 核心跳轉邏輯 ===
TeleportButton.MouseButton1Click:Connect(function()
    local targetId = tonumber(TextBox.Text)
    
    if not targetId then
        StatusLabel.Text = "❌ 請輸入有效的數字 ID！"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    StatusLabel.Text = "🔍 正在搜尋玩家伺服器位置..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
    TeleportButton.Instance = false -- 防止重複點擊
    
    -- 使用 pcall 防止因為玩家離線或隱私權限關閉導致腳本崩潰
    task.spawn(function()
        local success, errorMessage, placeId, instanceId = pcall(function()
            return TeleportService:GetPlayerPlaceInstanceAsync(targetId)
        end)
        
        if success then
            StatusLabel.Text = "✅ 成功找到伺服器！正在傳送..."
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            task.wait(1)
            -- 執行跨伺服器或同遊戲伺服器跳轉
            TeleportService:TeleportToPlaceInstance(placeId, instanceId, LocalPlayer)
        else
            StatusLabel.Text = "❌ 失敗: 玩家離線或隱私權限未開啟"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            warn("追蹤失敗原因: " .. tostring(errorMessage))
        end
        TeleportButton.Instance = true
    end)
end)
